PORT=3000
NODE_ENV=development
# Number of trusted reverse proxies (0 locally, usually 1 on Render)
TRUST_PROXY_HOPS=0

# PostgreSQL / Supabase connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
DATABASE_SSL=true

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origins allowed by CORS. Separate multiple URLs with commas.
FRONTEND_URLS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000

# Optional Supabase Storage upload support
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=lostlink-images

# Used only by: npm run seed:admin
ADMIN_NAME=LostLink Admin
ADMIN_EMAIL=admin@usth.edu.vn
ADMIN_PASSWORD=change_me_before_running_seed
